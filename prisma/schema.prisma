generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Folder {
  id         String      @id @default(cuid())
  name       String
  userId     String?
  createdAt  DateTime    @default(now())
  recordings Recording[]

  @@index([userId])
}

model Recording {
  id                 String    @id @default(cuid())
  title              String    @default("")
  createdAt          DateTime  @default(now())
  duration           Int       @default(0)
  fileSize           Int       @default(0)
  mimeType           String    @default("")
  audioPath          String    @default("")
  status             String    @default("uploading")
  source             String    @default("web")
  meetingType        String    @default("general")
  // What the client believed it captured: "mic-sys" = your mic on the left,
  // the call on the right; "mono" = a single blended track. Diagnostics only.
  // Finalize detects the real layout from the audio itself, so an old client
  // or a wrong value here can never misroute diarisation.
  channelLayout      String?
  // Which conferencing service the call was on: teams | meet | zoom | webex |
  // slack | generic. Read from the shared surface's own title at capture time.
  // `source` stays 'web' | 'teams' for the existing list filter and search;
  // this carries the detail so a Google Meet call is not badged as Teams.
  // Null on in-person recordings and on anything recorded before this existed.
  meetingProvider    String?
  folderId           String?
  userId             String?
  // The owner's Contacts organisation, stamped at create from getUserOrgId().
  // Denormalised deliberately: org membership is read over a raw SQL join into
  // another app's tables, and a per-row lookup on every list render is not
  // affordable. It also freezes the tenant a meeting belongs to at the moment
  // it was recorded, which is the correct semantics — a person changing
  // employer must not drag their old employer's meetings with them.
  // Null on rows recorded before this existed and on users with no org.
  orgId              String?
  // Soft delete: hidden from all lists immediately, hard-purged by cron after 30 days
  deletedAt          DateTime?
  // Idempotency stamps — each side effect fires at most once per recording
  teamsNotifiedAt    DateTime?
  airtableBackedUpAt DateTime?

  folder            Folder?            @relation(fields: [folderId], references: [id])
  chunks            ChunkBlob[]
  finalizeJob       FinalizeJob?
  transcript        Transcript?
  summary           Summary?
  speakerEmbeddings SpeakerEmbedding[]

  // deletedAt kept standalone for the 30-day purge cron (WHERE deletedAt < cutoff).
  // Composite indexes match the home/list query shape: scope by user/folder,
  // exclude soft-deleted, order by createdAt desc — so the planner can serve the
  // list straight from the index instead of scanning + sorting.
  @@index([deletedAt])
  @@index([userId, deletedAt, createdAt])
  @@index([folderId, deletedAt, createdAt])
  @@index([userId, source, deletedAt, createdAt])
  // Tenant-scoped list: an admin viewing everyone sees their own org only.
  @@index([orgId, deletedAt, createdAt])
}

// Mirrors auth.users — stores per-user Transcribe permission flags.
// Written by FTC Contacts super admin; read here to scope recording visibility.
model TranscribePermission {
  userId       String   @id @map("user_id")
  canSeeAll    Boolean  @default(false) @map("can_see_all")
  // Meeting audio playback — default on; super admin can switch it off per user
  canPlayAudio Boolean  @default(true) @map("can_play_audio")
  grantedAt    DateTime @default(now()) @map("granted_at")

  @@map("transcribe_permissions")
}

// Per-user app preferences. One row per user (user_id = auth uid). A reserved
// row user_id='DEFAULT' holds the super-admin-set global default; individual
// user rows override it. A null column means "inherit" (fall back to DEFAULT,
// then the hardcoded default). liveFx = card motion / spotlight-glow effects.
model UserSetting {
  userId    String   @id @map("user_id")
  liveFx    Boolean? @map("live_fx")
  // Consent to let the dictation app send short voice snippets here for
  // voiceprint training. Null = never answered, which resolves to OFF: the
  // desktop app keeps every recording on the device until this says otherwise.
  // One row read and written by BOTH apps, so the two toggles cannot drift.
  voiceTraining Boolean? @map("voice_training")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}

// Raw audio chunks stored during recording — transcribed in bulk at finalize time.
// Storing audio here (instead of transcribing inline) means the upload phase
// can never fail due to AI API errors, rate limits, or timeouts.
model ChunkBlob {
  id          String    @id @default(cuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  audioData   Bytes
  offset      Float     @default(0)
  mimeType    String    @default("audio/webm")
  // SHA-256 of the audio bytes — a partial unique index (raw DDL in
  // ensure-schema) rejects retry-duplicated chunks at the database level
  contentHash String    @default("")
  createdAt   DateTime  @default(now())

  @@index([recordingId, offset])
}

model FinalizeJob {
  id          String            @id @default(cuid())
  recordingId String            @unique
  recording   Recording         @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  status      String            @default("pending")
  attempts    Int               @default(0)
  lockToken   String?
  lockUntil   DateTime?
  lastError   String            @default("")
  // Earliest time this job may be claimed again. Without it a job that always
  // fails floats to the front of the `updatedAt asc` queue and consumes a
  // worker slot every five minutes for ever — which is what one poison chunk
  // did to recording cmtbd1od3 on 27 Aug 2026, nine runs deep, while other
  // users' recordings queued behind it.
  nextAttemptAt DateTime?
  // Terminal give-up. A job that has exhausted its attempts stops being picked
  // up at all, so one broken recording can never degrade throughput for
  // everyone else. The recording is marked failed and the user can retry it by
  // hand from the recording page.
  deadLettered  Boolean         @default(false)
  // Which phase the worker is in, so the page can show real progress instead
  // of a spinner and a guess: transcribing | diarising | analysing | done.
  stage       String            @default("")
  // The current run's processing window. `createdAt` is when the job was
  // ENQUEUED, which happens while the meeting is still being recorded, so it
  // cannot be used to measure how long processing takes. These two can, and
  // that measurement is what the ETA is built from.
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chunks      ChunkTranscript[]

  @@index([status, updatedAt])
  // The worker's claim query: eligible status, backoff elapsed, not dead.
  @@index([status, deadLettered, nextAttemptAt])
}

model ChunkTranscript {
  id          String      @id @default(cuid())
  jobId       String
  job         FinalizeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recordingId String
  chunkId     String
  offset      Float       @default(0)
  status      String      @default("pending")
  attempts    Int         @default(0)
  lastError   String      @default("")
  transcript  String      @default("")
  segments    String      @default("[]")
  voiceData   String      @default("")
  processedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([jobId, chunkId])
  @@index([recordingId, status, offset])
  @@index([jobId, status])
}

model Transcript {
  id          String    @id @default(cuid())
  recordingId String    @unique
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  fullText    String
  segments    String
  // Whisper-detected language ("english", …); '' when unknown (pre-column rows)
  language    String    @default("")
  createdAt   DateTime  @default(now())
}

model Summary {
  id                 String    @id @default(cuid())
  recordingId        String    @unique
  recording          Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  overview           String
  keyPoints          String
  actionItems        String
  decisions          String
  topics             String    @default("[]")
  actionItemsChecked String    @default("[]")
  actionItemsDue     String    @default("[]")
  createdAt          DateTime  @default(now())
}

// Acoustic voice profiles — one row per enrollment phrase or relabel sample.
// embedding is a JSON array of 192 floats from the CAM++ speaker model.
model VoiceProfile {
  id          String   @id @default(cuid())
  userId      String?
  personName  String
  embedding   String
  durationS   Float    @default(0)
  source      String   @default("enrollment") // enrollment | relabel | auto | match
  deviceLabel String   @default("")
  // Provenance: which recording the sample was learned from (null = enrollment)
  // and what that voice said there — lets the user audit + prune training data.
  recordingId String?
  excerpt     String   @default("")
  // Enrollment clip audio kept for playback (tiny — a few hundred KB per sample).
  // Meeting-derived samples play from the recording's archived audio instead.
  audioData   Bytes?
  audioMime   String   @default("")
  // Reserved for storage-bucket clip paths once SUPABASE_SERVICE_ROLE_KEY is set
  audioPath   String   @default("")
  // Which stretch of `recordingId` actually trained this sample, in
  // recording-global seconds, plus the diarizer label it carried at learn
  // time. Recorded here rather than re-derived later: the transcript stores
  // "Speaker 2", never the person's name, so matching segments by personName
  // finds nothing and the sample inspector cannot show or play the clip.
  clipStartS   Float?
  clipEndS     Float?
  speakerLabel String  @default("")
  createdAt   DateTime @default(now())
  // Which embedding model produced `embedding`. Matching NEVER crosses spaces,
  // so this is a correctness guard, not metadata: comparing a campplus vector to
  // a titanet-large-v1 one yields meaningless similarity. The column was added by
  // raw DDL in lib/ensure-schema.ts and was missing here, which meant a
  // `prisma db push` would read it as drift and drop it. Declared so it cannot.
  modelVersion String  @default("campplus")

  @@index([userId])
  @@index([personName])
}

// Per-recording global speaker voiceprints — powers matching + relearn-on-rename
model SpeakerEmbedding {
  id           String    @id @default(cuid())
  recordingId  String
  recording    Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  speakerLabel String
  embedding    String
  durationS    Float     @default(0)
  createdAt    DateTime  @default(now())
  // See VoiceProfile.modelVersion — same guard, same reason it was missing.
  modelVersion String    @default("campplus")

  @@index([recordingId])
}

// Speaker voice profiles — cross-recording speaker identification
model SpeakerProfile {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  features    String // JSON: { avgSegDuration, avgPause, speakingRate, topWords }
  sampleCount Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Append-only audit trail of user-visible actions (create/delete/export/chat/
// voice enrolment...). orgId is the actor's Contacts organisation — Transcribe
// reuses the Contacts org tables rather than keeping its own org model.
// Written via lib/audit.ts; a failed write never fails the audited action.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String?
  userEmail  String?
  orgId      String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   String? // JSON

  @@index([userId, createdAt])
  @@index([targetId])
  @@index([createdAt])
}

// Deduplication log for the auto-fix pipeline. One row per unique error
// message (hashed) within a 24-hour window — prevents 49 identical errors
// from spawning 49 PRs.
model AutoFixAttempt {
  id        String   @id @default(cuid())
  errorHash String
  errorMsg  String
  source    String   @default("")
  prUrl     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([errorHash, createdAt])
}
