# Dependencies
node_modules/
fireflies-clone/backend/venv/

# Next.js build output
.next/
out/

# Database files
*.db
*.db-journal
prisma/migrations/

# Environment (contains API keys — never commit)
.env
.env.local
.env*.local
# `.env*.local` does NOT match this one, so it needs its own line: it is what
# `vercel env pull` writes and it holds production secrets.
.env.pulled

# Uploads
uploads/

# Voice-ID ONNX models (downloaded at runtime / via models/README)
models/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# Claude Code local settings
.claude/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vercel

# transcript data - contains real customer meeting text, never commit
migration-part*.sql
migration-to-contacts.sql
run-*.sql

graphify-out/

# Local data snapshots + generated test voices (never commit meeting data)
.local/

# local export previews (scripts/preview-export.ts)
tmp-export/

# Local agent/tooling state — machine-specific, not shared knowledge
.claude-flow/
.dream-digest
.last-dream

# Backups and incremental build state
*.bak
tsconfig.tsbuildinfo

# Playwright output
test-results/
playwright-report/

# Stale Next.js build cache left behind by interrupted builds
.next.stale-cache/
